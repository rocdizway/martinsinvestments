# Public canonical origin used by SEO metadata. Do not include a trailing slash.
VITE_SITE_URL=https://www.martinsinvestments.com

# Optional. Analytics remains disabled when this is empty and always requires visitor consent.
VITE_GA_MEASUREMENT_ID=

# Optional public WordPress REST API root. Include /wp-json/wp/v2 and no trailing slash.
# When empty, Perspectives uses the three static posts in src/data/group.ts.
VITE_WORDPRESS_API_URL=
